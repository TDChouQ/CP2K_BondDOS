! CP2K BondDOS example input (diamond Si, RKS insulator, even k-mesh), tested with CP2K 2026.2.
! Lines marked  <== BondDOS  are what BondDOS needs in addition to a normal single-point calculation.
! Run:   mpirun -np 4 cp2k.psmp -i Si_rks.inp -o Si_rks.out      (bonddos_print.inc must be in the same folder)
! Then:  python main.py cohp cohp_Si_rks.in      or open cohp_mo-1_0.mokp in the GUI page "k 点成键 COHP"
&GLOBAL
  PROJECT Si_rks
  RUN_TYPE ENERGY                       ! single point on the final (relaxed) geometry
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &SCF
      EPS_SCF 1.0E-7
      MAX_SCF 200
      ADDED_MOS 20                      ! <== BondDOS: empty bands to export (cover the antibonding region)
      &DIAGONALIZATION                  ! <== BondDOS: diagonalisation, not OT (k-points)
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
    &END SCF
    &KPOINTS                            ! <== BondDOS: required, also for Gamma only (SCHEME GAMMA)
      SCHEME MONKHORST-PACK 4 4 4
      GAMMA_CENTERED T                  ! even mesh: keep the fcc symmetry
      SYMMETRY F
    &END KPOINTS
    &PRINT
      @INCLUDE 'bonddos_print.inc'      ! <== BondDOS: &MO_KP + &KS_CSR_WRITE
      &DOS                              ! optional: CP2K's own DOS / PDOS per KIND (page 1 of BondDOS)
        DELTA_E 0.0003674932
        NLUMO 20
        &CURVE
          ENERGY_UNIT EV
          ENERGY_ZERO FERMI
          &BROADEN
            TYPE GAUSSIAN
            WIDTH [eV] 0.10
          &END BROADEN
        &END CURVE
        &PDOS
          COMPONENTS F
        &END PDOS
      &END DOS
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A 0.0 2.71550 2.71550
      B 2.71550 0.0 2.71550
      C 2.71550 2.71550 0.0
    &END CELL
    &COORD
      Si 0.0 0.0 0.0
      Si 1.35775 1.35775 1.35775
    &END COORD
    &KIND Si
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q4
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
