&GLOBAL
  PROJECT si
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL
&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    UKS T
    MULTIPLICITY 6
    &QS
      EPS_DEFAULT 1.0E-12
    &END QS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
    &SCF
      EPS_SCF 1.0E-8
      MAX_SCF 300
      ADDED_MOS 4
      &DIAGONALIZATION
      &END DIAGONALIZATION
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.2
        NBROYDEN 8
      &END MIXING
      &SMEAR ON
        METHOD FERMI_DIRAC
        ELECTRONIC_TEMPERATURE [K] 3000
        FIXED_MAGNETIC_MOMENT 5
      &END SMEAR
    &END SCF
    &KPOINTS
      SCHEME MONKHORST-PACK 3 3 3
      FULL_GRID T
      SYMMETRY F
      WAVEFUNCTIONS COMPLEX
    &END KPOINTS
    &PRINT
      &DOS
        DELTA_E 0.0003674932
        NLUMO 20
        NDIGITS 8
        &CURVE
          ENERGY_UNIT EV
          ENERGY_ZERO FERMI
          &BROADEN
            TYPE GAUSSIAN
            WIDTH [eV] 0.10
          &END BROADEN
        &END CURVE
        &PDOS
          COMPONENTS F
        &END PDOS
      &END DOS
      &MULLIKEN ON
      &END MULLIKEN
      &LOWDIN ON
      &END LOWDIN
      &MO_KP ON
        FILENAME ./cohp_mo
        AO_EXPORT_TYPE OVERLAP_MATRIX
        NDIGITS 14
        UNIT ANGSTROM
      &END MO_KP
      &KS_CSR_WRITE ON
        FILENAME ./cohp_ks
        REAL_SPACE F
        BINARY F
        THRESHOLD 0.0
        UPPER_TRIANGULAR F
        ADD_LAST SYMBOLIC
        &EACH
          QS_SCF 0
        &END EACH
      &END KS_CSR_WRITE
    &END PRINT
  &END DFT
  &SUBSYS
    &CELL
      A 0.0000000000 2.2225000000 2.2225000000
      B 2.2225000000 0.0000000000 2.2225000000
      C 2.2225000000 2.2225000000 0.0000000000
    &END CELL
    &COORD
      Mn 4.4450000000 -2.2225000000 2.2225000000
      O 2.2225000000 2.2225000000 2.2225000000
    &END COORD
    &KIND Mn
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q15
      MAGNETIZATION 5
    &END KIND
    &KIND O
      BASIS_SET SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
